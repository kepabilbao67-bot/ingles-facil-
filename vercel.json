{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web-preview",
  "installCommand": "npm ci",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/call/:characterId", "destination": "/_dynamic/call" },
    { "source": "/character/:characterId", "destination": "/_dynamic/character" },
    { "source": "/lesson/:lessonId", "destination": "/_dynamic/lesson" },
    { "source": "/quiz/:lessonId", "destination": "/_dynamic/quiz" },
    { "source": "/result/:lessonId", "destination": "/_dynamic/result" }
  ]
}
