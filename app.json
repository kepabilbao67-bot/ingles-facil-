{
  "expo": {
    "name": "LinguaFox",
    "slug": "LinguaFox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/linguafox-icon-v2.png",
    "scheme": "linguafox",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/images/linguafox-ios-icon-1024.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.kepabilbao.linguafox",
      "buildNumber": "1"
    },
    "android": {
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/linguafox-icon-v2.png",
        "backgroundColor": "#0B1438"
      },
      "package": "com.kepabilbao.linguafox",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/linguafox-icon-v2.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1438",
          "imageWidth": 200
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "38dcd265-7c77-4189-a5a5-bcf0fde90f80"
      }
    }
  }
}
